# Clawdbot Configuration Example
# Copy this file to .env and fill in your values

# Clawdbot Profile (optional, default: default)
CLAWDBOT_PROFILE=default

# Node Environment
NODE_ENV=production

# Installation Settings
CLAWDBOT_NO_PROMPT=1
CLAWDBOT_NO_ONBOARD=1
CLAWDBOT_INSTALL_METHOD=npm

# API Keys and Credentials (if needed)
# ANTHROPIC_API_KEY=your_api_key_here
# OPENAI_API_KEY=your_openai_key_here

# Bot Configuration
# BOT_NAME=ClawdBot
# BOT_PREFIX=!

# Logging
# LOG_LEVEL=info

# Network Configuration
# HTTP_PORT=8080
# ENABLE_HTTPS=false

# Database (if applicable)
# DB_HOST=localhost
# DB_PORT=5432
# DB_NAME=clawdbot
# DB_USER=clawdbot
# DB_PASSWORD=your_password_here

# Redis (if applicable)
# REDIS_HOST=localhost
# REDIS_PORT=6379
# REDIS_PASSWORD=

# Additional Settings
# TIMEZONE=UTC
# LOCALE=en_US
